<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02030A">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6050714"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tile"
            android:minHeight="48dp"
            android:text="@string/home"
            android:textAllCaps="false"
            android:textColor="#F4F7FF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/rotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tile"
            android:minHeight="48dp"
            android:text="@string/rotate"
            android:textAllCaps="false"
            android:textColor="#F4F7FF"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#F4F7FF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_go"
            android:minHeight="48dp"
            android:text="@string/blocking"
            android:textAllCaps="false"
            android:textColor="#041018"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tile"
            android:minHeight="48dp"
            android:text="@string/video"
            android:textAllCaps="false"
            android:textColor="#F4F7FF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_go"
            android:minHeight="48dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="#041018"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F202030A"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gate_title"
            android:textColor="#F4F7FF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gate_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#3ECBFF"
            android:textSize="42sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
