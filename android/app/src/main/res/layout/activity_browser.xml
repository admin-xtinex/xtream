<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02030A">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EE050714"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/action_btn_min_height"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/home"
                android:textAllCaps="false"
                android:textColor="#F4F7FF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/nav_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/action_btn_min_height"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cursor"
                android:textAllCaps="false"
                android:textColor="#F4F7FF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/rotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/action_btn_min_height"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/rotate"
                android:textAllCaps="false"
                android:textColor="#F4F7FF"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:ellipsize="end"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:textColor="#F4F7FF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_go"
                android:minHeight="@dimen/action_btn_min_height"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/blocking"
                android:textAllCaps="false"
                android:textColor="#041018"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/action_btn_min_height"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/video"
                android:textAllCaps="false"
                android:textColor="#F4F7FF"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/action_btn_min_height"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="#F4F7FF"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_accent"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F202030A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/load_ring"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/load_ring" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="120dp"
            android:letterSpacing="0.18"
            android:text="@string/loading"
            android:textAllCaps="true"
            android:textColor="#F4F7FF"
            android:textSize="14sp" />
    </FrameLayout>
</FrameLayout>
